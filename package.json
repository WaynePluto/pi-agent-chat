{
  "name": "pi-code-agent-chat",
  "displayName": "Pi Agent Chat",
  "description": "VS Code sidebar chat for the Pi Coding Agent, powered by the official SDK (0.83.0) bundled inside the extension — no Pi CLI required. Unofficial community project.",
  "version": "0.0.5",
  "publisher": "waynepluto",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WaynePluto/pi-agent-chat.git"
  },
  "bugs": {
    "url": "https://github.com/WaynePluto/pi-agent-chat/issues"
  },
  "homepage": "https://github.com/WaynePluto/pi-agent-chat#readme",
  "packageManager": "pnpm@10.20.0",
  "keywords": [
    "pi",
    "agent",
    "chat",
    "ai",
    "coding-agent"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:piAgentChat.view"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piAgentChat",
          "title": "Pi Agent Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "piAgentChat": [
        {
          "id": "piAgentChat.view",
          "name": "Pi Agent Chat",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "piAgentChat.newSession",
        "title": "Pi Agent Chat: New Session"
      },
      {
        "command": "piAgentChat.focus",
        "title": "Pi Agent Chat: Focus Chat"
      },
      {
        "command": "piAgentChat.runSpikeDiagnostics",
        "title": "Pi Agent Chat: Run Spike Diagnostics"
      },
      {
        "command": "piAgentChat.runSpikeLiveTest",
        "title": "Pi Agent Chat: Run Spike Live Test (uses API tokens)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "verify": "node esbuild.mjs && python scripts/check_bundle.py && node scripts/smoke_load.mjs && node scripts/smoke_webview.mjs",
    "vscode:prepublish": "npm run package",
    "package:vsix": "vsce package --no-dependencies --githubBranch master --readme-path README.md --out pi-code-agent-chat.vsix",
    "install:vsix": "code --install-extension pi-code-agent-chat.vsix --force",
    "package-and-install:vsix": "npm run package:vsix && npm run install:vsix"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "diff": "8.0.4",
    "marked": "16.4.2",
    "undici": "8.8.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "8.8.0"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.12",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3"
  }
}
