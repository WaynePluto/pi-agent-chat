{
  "name": "pi-code-agent-chat",
  "displayName": "Pi Agent Chat",
  "description": "%extension.description%",
  "version": "0.0.12",
  "publisher": "waynepluto",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WaynePluto/pi-agent-chat.git"
  },
  "bugs": {
    "url": "https://github.com/WaynePluto/pi-agent-chat/issues"
  },
  "homepage": "https://github.com/WaynePluto/pi-agent-chat#readme",
  "packageManager": "pnpm@10.20.0",
  "keywords": [
    "pi",
    "agent",
    "chat",
    "ai",
    "coding-agent"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:piAgentChat.view"
  ],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "piAgentChat.subagent.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%configuration.subagent.enabled%"
        },
        "piAgentChat.subagent.maxSubagents": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "scope": "resource",
          "markdownDescription": "%configuration.subagent.maxSubagents%"
        },
        "piAgentChat.subagent.defaultModel": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%configuration.subagent.defaultModel%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piAgentChat",
          "title": "Pi Agent Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "piAgentChat": [
        {
          "id": "piAgentChat.view",
          "name": "Pi Agent Chat",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "piAgentChat.newSession",
        "title": "%command.newSession.title%"
      },
      {
        "command": "piAgentChat.focus",
        "title": "%command.focus.title%"
      },
      {
        "command": "piAgentChat.runSpikeDiagnostics",
        "title": "Pi Agent Chat: Run Spike Diagnostics"
      },
      {
        "command": "piAgentChat.runSpikeLiveTest",
        "title": "Pi Agent Chat: Run Spike Live Test (uses API tokens)"
      }
    ]
  },
  "scripts": {
    "prepare": "husky",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "python scripts/check_dependency_versions.py",
    "verify": "pnpm check:dependencies && node esbuild.mjs && python scripts/check_bundle.py && node scripts/check_extension_runtime.mjs && node scripts/smoke_load.mjs && node scripts/smoke_webview.mjs",
    "vscode:prepublish": "npm run package",
    "package:vsix": "vsce package --no-dependencies --githubBranch master --readme-path README.md --out pi-code-agent-chat.vsix",
    "install:vsix": "code --install-extension pi-code-agent-chat.vsix --force",
    "package-and-install:vsix": "npm run package:vsix && npm run install:vsix"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "diff": "9.0.0",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "marked": "18.0.9",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
