{
  "name": "pi-code-agent-chat",
  "displayName": "Pi Agent Chat",
  "description": "%extension.description%",
  "version": "0.0.15-20260825",
  "publisher": "waynepluto",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WaynePluto/pi-agent-chat.git"
  },
  "bugs": {
    "url": "https://github.com/WaynePluto/pi-agent-chat/issues"
  },
  "homepage": "https://github.com/WaynePluto/pi-agent-chat#readme",
  "packageManager": "pnpm@10.20.0",
  "keywords": [
    "pi",
    "agent",
    "chat",
    "ai",
    "coding-agent"
  ],
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:piAgentChat.view",
    "onWebviewPanel:piAgentChat.editor"
  ],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "piAgentChat.subagent.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%configuration.subagent.enabled%"
        },
        "piAgentChat.subagent.maxSubagents": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "scope": "resource",
          "markdownDescription": "%configuration.subagent.maxSubagents%"
        },
        "piAgentChat.subagent.defaultModel": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%configuration.subagent.defaultModel%"
        },
        "piAgentChat.terminal.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%configuration.terminal.enabled%"
        },
        "piAgentChat.terminal.maxTerminals": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "scope": "resource",
          "markdownDescription": "%configuration.terminal.maxTerminals%"
        },
        "piAgentChat.layout.contentMaxWidth": {
          "type": "number",
          "default": 950,
          "minimum": 500,
          "scope": "window",
          "markdownDescription": "%configuration.layout.contentMaxWidth%"
        },
        "piAgentChat.layout.wideModeMinWidth": {
          "type": "number",
          "default": 1200,
          "minimum": 932,
          "scope": "window",
          "markdownDescription": "%configuration.layout.wideModeMinWidth%"
        },
        "piAgentChat.transcript.foldLines": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "scope": "window",
          "markdownDescription": "%configuration.transcript.foldLines%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piAgentChat",
          "title": "Pi Agent Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "piAgentChat": [
        {
          "id": "piAgentChat.view",
          "name": "Pi Agent Chat",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "piAgentChat.newSession",
        "title": "%command.newSession.title%"
      },
      {
        "command": "piAgentChat.focus",
        "title": "%command.focus.title%"
      },
      {
        "command": "piAgentChat.moveSessionToEditor",
        "title": "%command.moveSessionToEditor.title%"
      },
      {
        "command": "piAgentChat.moveSessionToSidebar",
        "title": "%command.moveSessionToSidebar.title%"
      },
      {
        "command": "piAgentChat.moveSessionFromSidebarToWindow",
        "title": "%command.moveSessionToWindow.title%"
      },
      {
        "command": "piAgentChat.moveSessionFromEditorToWindow",
        "title": "%command.moveSessionToWindow.title%"
      },
      {
        "command": "piAgentChat.newEditorSession",
        "title": "%command.newEditorSession.title%"
      },
      {
        "command": "piAgentChat.newWindowSession",
        "title": "%command.newWindowSession.title%"
      },
      {
        "command": "piAgentChat.moveSessionToEditorArea",
        "title": "%command.moveSessionToEditorArea.title%"
      },
      {
        "command": "piAgentChat.runSpikeDiagnostics",
        "title": "Pi Agent Chat: Run Spike Diagnostics"
      },
      {
        "command": "piAgentChat.runSpikeLiveTest",
        "title": "Pi Agent Chat: Run Spike Live Test (uses API tokens)"
      },
      {
        "command": "piAgentChat.runTerminalSpike",
        "title": "Pi Agent Chat: Run Terminal Shell Integration Spike"
      }
    ],
    "submenus": [
      {
        "id": "piAgentChat.moveSessionFromSidebarMenu",
        "label": "%menu.moveSession.label%",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "submenu": "piAgentChat.moveSessionFromSidebarMenu",
          "when": "view == piAgentChat.view",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "piAgentChat.moveSessionToSidebar",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'editor' && !piAgentChat.chatTabSessionEmpty",
          "group": "9_piAgentChat@1"
        },
        {
          "command": "piAgentChat.moveSessionFromEditorToWindow",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'editor' && !piAgentChat.chatTabSessionEmpty",
          "group": "9_piAgentChat@2"
        },
        {
          "command": "piAgentChat.newEditorSession",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'editor'",
          "group": "9_piAgentChat@3"
        },
        {
          "command": "piAgentChat.newWindowSession",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'editor'",
          "group": "9_piAgentChat@4"
        },
        {
          "command": "piAgentChat.moveSessionToSidebar",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'window' && !piAgentChat.chatTabSessionEmpty",
          "group": "9_piAgentChat@1"
        },
        {
          "command": "piAgentChat.moveSessionToEditorArea",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'window' && !piAgentChat.chatTabSessionEmpty",
          "group": "9_piAgentChat@2"
        },
        {
          "command": "piAgentChat.newEditorSession",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'window'",
          "group": "9_piAgentChat@3"
        },
        {
          "command": "piAgentChat.newWindowSession",
          "when": "activeWebviewPanelId == piAgentChat.editor && piAgentChat.chatTabRegion == 'window'",
          "group": "9_piAgentChat@4"
        }
      ],
      "piAgentChat.moveSessionFromSidebarMenu": [
        {
          "command": "piAgentChat.moveSessionToEditor",
          "when": "!piAgentChat.sidebarSessionEmpty",
          "group": "navigation@1"
        },
        {
          "command": "piAgentChat.moveSessionFromSidebarToWindow",
          "when": "!piAgentChat.sidebarSessionEmpty",
          "group": "navigation@2"
        },
        {
          "command": "piAgentChat.newEditorSession",
          "group": "2_new@1"
        },
        {
          "command": "piAgentChat.newWindowSession",
          "group": "2_new@2"
        }
      ],
      "commandPalette": [
        {
          "command": "piAgentChat.moveSessionToEditor",
          "when": "false"
        },
        {
          "command": "piAgentChat.moveSessionToEditorArea",
          "when": "false"
        },
        {
          "command": "piAgentChat.moveSessionToSidebar",
          "when": "false"
        },
        {
          "command": "piAgentChat.moveSessionFromSidebarToWindow",
          "when": "false"
        },
        {
          "command": "piAgentChat.moveSessionFromEditorToWindow",
          "when": "false"
        },
        {
          "command": "piAgentChat.newEditorSession",
          "when": "false"
        },
        {
          "command": "piAgentChat.newWindowSession",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "python scripts/check_dependency_versions.py",
    "verify": "pnpm check:dependencies && node esbuild.mjs && python scripts/check_bundle.py && node scripts/check_terminal_replay.mjs && node scripts/check_extension_runtime.mjs && node scripts/smoke_load.mjs && node scripts/smoke_webview.mjs",
    "vscode:prepublish": "npm run package",
    "package:vsix": "vsce package --no-dependencies --githubBranch master --readme-path README.md --out pi-code-agent-chat.vsix",
    "install:vsix": "code --install-extension pi-code-agent-chat.vsix --force",
    "package-and-install:vsix": "npm run package:vsix && npm run install:vsix"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "diff": "9.0.0",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "marked": "18.0.11",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/vscode": "1.99.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "sass": "1.103.1",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
