{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "pnpm watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(?:[✘▲])\\s*\\[(\\w+)\\]\\s*(.*)$",
          "severity": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[esbuild\\] (?:building|watching)",
          "endsPattern": "^\\[esbuild\\] watching\\.\\.\\."
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "verify",
      "type": "shell",
      "command": "pnpm verify",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
