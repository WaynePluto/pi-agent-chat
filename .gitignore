node_modules/
dist/
out/
*.vsix

# npm/yarn lock files are not used by this pnpm project.
# pnpm-lock.yaml is tracked for reproducible CI and release builds.
package-lock.json
yarn.lock
npm-shrinkwrap.json

.DS_Store
*.log
.pi-plan.md
.agent-plan.md
todo.md

# refactor-review 过程产物：基线快照与交付报告不进版本库。
baseline.json
refactor-review-report.md
__pycache__/

# Throwaway workspace: screenshots, one-off probe extensions and their
# user-data dirs. Nothing here is an input to the build or the docs.
scratch/

# Per-workspace runtime state written by pi extensions (the services registry
# and the process logs it tails). Machine-local, never shared.
.pi/

# Exclude the *contents* of .vscode, not the directory itself: git cannot
# re-include a file whose parent directory is excluded, so a bare `.vscode`
# would make the two negations below dead letters.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
