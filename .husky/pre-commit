# Direct dependencies must be pinned to exact versions (no ^, ~, ranges, dist-tags).
pnpm check:dependencies || exit 1

# Keep pnpm-lock.yaml portable: drop tarball URLs from resolutions so each
# environment resolves packages through its own registry (same intent as
# lockfile-include-tarball-url=false in .npmrc).
if git diff --cached --name-only | grep -q '^pnpm-lock.yaml$'; then
  if grep -q 'tarball: http' pnpm-lock.yaml; then
    sed -i 's/, tarball: https\?:\/\/[^},]*//g' pnpm-lock.yaml
    git add pnpm-lock.yaml
    echo "[pre-commit] stripped registry tarball URLs from pnpm-lock.yaml"
  fi
fi
